# ======================================================
# THE PLINTH IQ Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ======================================================

# ── PostgreSQL ──────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/plinth_db"

# ── Application ─────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Cors ────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Admin Seed Credentials ─────────────────────────
# Used by `npm run prisma:seed` / `npx prisma db seed`
ADMIN_EMAIL=admin@plinth.art
ADMIN_PASSWORD=Admin@123456!
ADMIN_PHONE=+919584010353

